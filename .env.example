ID=dummy_id@example.com
PASSWORD=dummy_password

# Gemini API
GEMINI_API_KEY=AIzaSy_dummy_key_here

# Telegram
TELEGRAM_BOT_TOKEN=1234567890:AA_dummy_token_here
